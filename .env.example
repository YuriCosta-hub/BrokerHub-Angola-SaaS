# Environment

NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:pass@localhost:5432/brokerhub
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# P0 — production requires an explicit allowlist (scheme + host, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# P0 — MFA is always on in production. In development, set false only to test without 2FA.
MFA_ENFORCE=true

# Optional Clerk frontend proxy in production
# VITE_CLERK_PROXY_URL=

# P1 — APD
PRIVACY_POLICY_VERSION=2026-09-03
RETENTION_YEARS=5
INVITE_TTL_HOURS=72
TRIAL_DAYS=14

# P2 — workers (15 min). Never expose rls_bypass over HTTP.
WORKERS_ENABLED=true
WORKER_INTERVAL_MS=900000
SMS_GATEWAY_URL=
WHATSAPP_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# P2 — documentos locais (S3-compatível na mesma região em produção)
STORAGE_DIR=./data/storage

# P2 — facturação
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
MULTICAIXA_ENTITY=

