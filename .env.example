# Environment

NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:pass@localhost:5432/brokerhub
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# P0 — production requires an explicit allowlist (scheme + host, comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# P0 — MFA is always on in production. In development, set false only to test without 2FA.
MFA_ENFORCE=true

# Optional Clerk frontend proxy in production
# VITE_CLERK_PROXY_URL=
